# Copy this file to .env and fill in the actual values
# DO NOT commit the .env file to version control

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?appName=AppName

# JWT
JWT_SECRET=your_very_secure_random_secret_key_change_this_in_production

# Server
PORT=3000
NODE_ENV=development

# Email Service
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_email@ethereal.email
SMTP_PASSWORD=your_password_here

# Frontend URL (for links in emails and CORS)
FRONTEND_URL=http://localhost:4200

